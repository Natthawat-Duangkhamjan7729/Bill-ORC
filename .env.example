NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImptemJpeXpmeHR4cnN4bHF2dnR6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU3NjI4MzcsImV4cCI6MjEwMTMzODgzN30.9JzIWQLBgfGoA1LKuNaejKCO4Si1DLWTB4eDQfIVwBY

# ── OCR: primary engine ───────────────────────────────────────────────
# Any OpenAI-compatible chat-completions API. Tried first.
#
# Running a local model with Ollama (see README "Using a local AI model"):
#   Use 127.0.0.1, NOT localhost — Node resolves "localhost" to IPv6 ::1
#   first, which Ollama does not listen on, giving a confusing "fetch failed".
#   No API key is needed for Ollama; leave OCR_API_KEY unset.
OCR_BASE_URL=http://127.0.0.1:11434/v1
OCR_MODEL=qwen2.5vl:7b
# OCR_API_KEY=

# ── OCR: fallback engine (optional) ───────────────────────────────────
# Used only when the primary fails, times out, or returns a receipt with
# no total and no items. Put your REAL key here in .env.local — never commit it.
OCR_FALLBACK_BASE_URL=https://gen.ai.kku.ac.th/api/v1
OCR_FALLBACK_MODEL=gemini-3.5-flash
OCR_FALLBACK_API_KEY=paste-your-key-here

# Cloud-only setup (this is what Vercel uses): set the KKU values as the
# PRIMARY pair above and leave the fallback block unset.
